<?xml version="1.0"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://zero-install.sourceforge.net/2004/injector/interface http://0install.de/schema/injector/interface/interface.xsd http://0install.de/schema/desktop-integration/capabilities http://0install.de/schema/desktop-integration/capabilities/capabilities.xsd">
  <name>JetBrains RustRover</name>
  <summary>A powerful IDE for Rust</summary>
  <icon href="https://raw.githubusercontent.com/0install/0install.de-feeds/master/RustRover.ico" type="image/vnd.microsoft.icon"/>
  <icon href="https://raw.githubusercontent.com/0install/0install.de-feeds/master/RustRover.png" type="image/png"/>
  <homepage>https://www.jetbrains.com/rust/</homepage>
  <category>Development</category>

  <feed-for interface="http://0install.de/feeds/RustRover.xml"/>

  <implementation arch="Windows-x86_64" main="bin/rustrover64.exe" released="{released}" stability="stable" version="{version}">
    <archive href="https://download.jetbrains.com/rustrover/RustRover-{version}.win.zip" type="application/zip"/>
  </implementation>
  <implementation arch="Windows-aarch64" main="bin/rustrover64.exe" released="{released}" stability="stable" version="{version}">
    <archive href="https://download.jetbrains.com/rustrover/RustRover-{version}-aarch64.win.zip" type="application/zip"/>
  </implementation>
  <implementation arch="Linux-x86_64" main="bin/rustrover.sh" released="{released}" stability="stable" version="{version}">
    <archive extract="RustRover-{version}" href="https://download.jetbrains.com/rustrover/RustRover-{version}.tar.gz" type="application/x-compressed-tar"/>
  </implementation>
  <implementation arch="Linux-aarch64" main="bin/rustrover.sh" released="{released}" stability="stable" version="{version}">
    <archive extract="RustRover-{version}" href="https://download.jetbrains.com/rustrover/RustRover-{version}-aarch64.tar.gz" type="application/x-compressed-tar"/>
  </implementation>
</interface>
